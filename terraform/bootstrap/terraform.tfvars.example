# Copiar a terraform.tfvars y ajustar.
github_repository = "OWNER/REPO"

# aws_region                  = "us-east-1"
# create_github_oidc_provider = true # false si la cuenta ya tiene el proveedor de GitHub
# Repos nuevos de GitHub usan "sub" inmutable. Si AssumeRoleWithWebIdentity falla, usar el valor de:
#   gh api repos/OWNER/REPO/actions/oidc/customization/sub   (campo sub_claim_prefix)
# github_subject_prefix = "repo:OWNER@ID/REPO@ID"
